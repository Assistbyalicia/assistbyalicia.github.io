      <th>Make</th>
      <th>n8n</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Prise en main</td>
      <td data-label="Zapier">La plus simple</td>
      <td data-label="Make">Intermédiaire</td>
      <td data-label="n8n">La plus technique</td>
    </tr>
    <tr>
      <td>Intégrations</td>
      <td data-label="Zapier">8 000+</td>
      <td data-label="Make">2 000+</td>
      <td data-label="n8n">1 500+</td>
    </tr>
    <tr>
      <td>Logique avancée (conditions, boucles)</td>
      <td data-label="Zapier">Limitée</td>
      <td data-label="Make">Oui</td>
      <td data-label="n8n">Oui</td>
    </tr>
    <tr>
      <td>IA intégrée (agents, LLM)</td>
      <td data-label="Zapier">Non</td>
      <td data-label="Make">Non</td>
      <td data-label="n8n">Oui</td>
    </tr>
    <tr>
      <td>Hébergement</td>
      <td data-label="Zapier">SaaS uniquement</td>
      <td data-label="Make">SaaS uniquement</td>
      <td data-label="n8n">SaaS ou auto-hébergé</td>
    </tr>
  </tbody>
</table>

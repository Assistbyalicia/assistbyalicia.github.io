            </tr>
            <tr>
              <td>Diagnostic</td>
              <td data-label="Mission Express">Questionnaire d'audit</td>
              <td data-label="Accompagnement Bras droit">Cartographie plus approfondie de tes process</td>
            </tr>
            <tr>
              <td>Rythme</td>
              <td data-label="Mission Express">Décidé en appel, selon ton besoin</td>
              <td data-label="Accompagnement Bras droit">Décidé en appel, évolutif au fil du temps</td>
            </tr>
            <tr>
              <td>Pour qui</td>
              <td data-label="Mission Express">Un point précis à régler maintenant</td>
              <td data-label="Accompagnement Bras droit">Un système à faire grandir avec ton activité</td>
            </tr>
          </tbody>
        </table>
      </div>

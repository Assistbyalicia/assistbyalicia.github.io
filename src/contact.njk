---
<body>

  <main>
    <!-- HERO CONTACT -->
    <section class="hero hero-contact">
      <div class="container">
        <div class="hero-intro">
          <p class="section-tag">Contact</p>
          <h1>On échange sur ton <span>besoin</span> ?</h1>
          <p class="hero-sub">
            Si tu veux clarifier ce qui coince dans ton organisation, vérifier si une offre est adaptée
            à ta situation, ou simplement me poser une question, tu peux me contacter ici.
          </p>
        </div>
      </div>
    </section>

    <!-- BLOCS CONTACT -->
    <section class="section-wrap tight">
      <div class="grid-2 contact-grid">
        <article class="card">
          <p class="section-tag">Prendre rendez-vous</p>
          <h2>Réserver un <span>appel</span></h2>
          <p>
            Le plus simple si tu veux qu’on parle directement de ton business, de ton organisation ou d’un besoin précis.
          </p>
          <div class="contact-info">
            <div>Appel diagnostic gratuit</div>
            <div>30 minutes</div>
            <div>Sans engagement</div>
          </div>
          <div class="hero-ctas">
            <a
              class="btn-primary"
              href="https://calendar.notion.so/meet/aliciachouquet/30min"
              target="_blank"
              rel="noopener noreferrer"
            >
              Réserver un appel
            </a>
          </div>
        </article>

        <article class="card">
          <p class="section-tag">M’écrire</p>
          <h2>M’écrire <span>directement</span></h2>
          <p>
            Si tu préfères commencer par un message, tu peux aussi m’écrire par email. Je reviendrai vers toi dès que possible.
          </p>
          <div class="contact-info">
            <div><strong>Email :</strong> <a href="mailto:contact@assistbyalicia.fr">contact@assistbyalicia.fr</a></div>
            <div><strong>Localisation :</strong> Sotteville-lès-Rouen</div>
            <div><strong>Réponse :</strong> dès que possible en semaine</div>
          </div>
          <div class="hero-ctas">
            <a class="btn-secondary" href="mailto:contact@assistbyalicia.fr">
              Envoyer un email
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- NOTE -->
    <section class="section-wrap tight">
      <div class="note-box">
        <p>
          Tu ne sais pas encore quelle offre choisir ? Commence par l’appel diagnostic : ce sera le plus simple pour faire le tri.
        </p>
      </div>
    </section>
  </main>


  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        menuToggle.classList.toggle('active', isOpen);
        menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        menuToggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
      });

      document.querySelectorAll('.mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          menuToggle.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Ouvrir le menu');
        });
      });
    }
  </script>
</body>